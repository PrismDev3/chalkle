<title>NZ: Portable — Single File</title>
<link rel="icon" href="data:image/vnd.microsoft.icon;base64,">
<style>
  :root {
    --bg: #050505;
    --panel: rgba(14, 12, 12, .82);
    --line: rgba(255, 84, 42, .28);
    --line-soft: rgba(255, 255, 255, .07);
    --amber: #ffb35c;
    --ember: #ff542a;
    --ember-hot: #ff7a3d;
    --blood: #b3160e;
    --text: #e8ddd2;
    --dim: #9b8f85;
    --mono: "Cascadia Mono", "JetBrains Mono", Consolas, "Courier New", monospace;
  }
  * { box-sizing: border-box; }
  html, body { height: 100%; }
  body {
    margin: 0; background: var(--bg); color: var(--text);
    font-family: var(--mono); overflow: hidden;
    text-rendering: optimizeSpeed;
  }

  /* ---------- background art ---------- */
  #bg { position: fixed; inset: 0; z-index: 0; }
  #bg img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    opacity: 0; transform: scale(1.06); transition: opacity 1.4s ease, transform 12s linear;
  }
  #bg img.on { opacity: .55; transform: scale(1.0); }
  #bg::after { /* vignette + grain */
    content: ""; position: absolute; inset: 0;
    background:
      radial-gradient(120% 90% at 50% 42%, transparent 40%, rgba(0,0,0,.75) 100%),
      linear-gradient(180deg, rgba(0,0,0,.55), transparent 30%, transparent 70%, rgba(0,0,0,.8));
  }
  #bg .scan { position: absolute; inset: 0; opacity: .10; mix-blend-mode: overlay;
    background: repeating-linear-gradient(0deg, transparent 0 2px, rgba(0,0,0,.9) 2px 4px); }

  /* ---------- game layer ---------- */
  #stack { position: fixed; inset: 0; z-index: 1; }
  canvas.emscripten {
    border: 0; padding: 0; margin: 0; display: block;
    width: 100%; height: 100%; background: #000;
    image-rendering: auto;
  }
  #fx { /* CRT overlay while playing (toggleable) */
    position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity .5s;
    background:
      repeating-linear-gradient(0deg, rgba(0,0,0,.14) 0 1px, transparent 1px 3px),
      radial-gradient(115% 90% at 50% 50%, transparent 60%, rgba(0,0,0,.35) 100%);
  }
  body.crt #fx { opacity: .5; }

  /* ---------- UI shell ---------- */
  #shell {
    position: fixed; inset: 0; z-index: 3; display: grid; place-items: safe center;
    background: radial-gradient(90% 70% at 50% 40%, rgba(30,8,4,.35), rgba(0,0,0,.88));
    transition: opacity .7s ease; overflow: auto;
  }
  #shell.gone { opacity: 0; pointer-events: none; }
  .card {
    width: min(560px, 92vw); margin: 4vh 0; padding: 34px 34px 26px;
    background: var(--panel); border: 1px solid var(--line);
    box-shadow: 0 30px 80px rgba(0,0,0,.7), inset 0 0 60px rgba(120, 20, 5, .12);
    backdrop-filter: blur(8px); position: relative;
  }
  .card::before { /* top ember line */
    content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--ember) 30%, var(--amber) 50%, var(--ember) 70%, transparent);
    filter: drop-shadow(0 0 6px rgba(255, 84, 42, .8));
  }
  .brand { display: flex; align-items: center; gap: 14px; margin-bottom: 6px; }
  .brand img { width: 44px; height: 44px; image-rendering: pixelated;
    filter: drop-shadow(0 0 8px rgba(255, 84, 42, .45)); }
  h1 {
    margin: 0; font-size: 26px; letter-spacing: .5px; color: #fff; font-weight: 700;
    text-shadow: 0 0 18px rgba(255, 84, 42, .55), 0 2px 0 #3a0d05;
  }
  h1 .tag { color: var(--amber); font-size: 13px; font-weight: 400; display: block; letter-spacing: 2px; margin-top: 3px; }
  .blurb { color: var(--dim); font-size: 12.5px; line-height: 1.6; margin: 10px 0 18px; }
  .blurb b { color: var(--text); font-weight: 600; }

  /* buttons */
  .btn {
    appearance: none; border: 1px solid var(--line); background: linear-gradient(180deg, rgba(255,84,42,.16), rgba(255,84,42,.05));
    color: var(--text); font-family: var(--mono); font-size: 14px; letter-spacing: 1px;
    padding: 13px 22px; cursor: pointer; width: 100%; margin-top: 10px;
    transition: transform .12s ease, box-shadow .2s, border-color .2s, background .2s;
    position: relative; overflow: hidden;
  }
  .btn:hover:not(:disabled) { border-color: var(--ember-hot); box-shadow: 0 0 24px rgba(255, 84, 42, .25); transform: translateY(-1px); }
  .btn:active:not(:disabled) { transform: translateY(0); }
  .btn:disabled { opacity: .45; cursor: default; }
  .btn.primary {
    font-size: 15px; padding: 15px 22px; color: #fff;
    background: linear-gradient(180deg, #7e1c08, #4c0f03);
    border-color: rgba(255, 122, 61, .55);
    text-shadow: 0 0 10px rgba(255, 160, 90, .6);
  }
  .btn.primary::after { /* sweep shine */
    content: ""; position: absolute; top: 0; bottom: 0; left: -60%; width: 40%;
    background: linear-gradient(105deg, transparent, rgba(255,255,255,.14), transparent);
    animation: sweep 3.2s ease-in-out infinite;
  }
  @keyframes sweep { 0%, 55% { left: -60%; } 90%, 100% { left: 130%; } }
  .btn.ghost { background: transparent; font-size: 12px; padding: 10px 14px; color: var(--dim); }
  .btn.ghost:hover { color: var(--text); box-shadow: none; }
  .row { display: flex; gap: 10px; } .row .btn { margin-top: 10px; }

  /* progress */
  #pwrap { margin-top: 16px; }
  #plabel { display: flex; justify-content: space-between; font-size: 11.5px; color: var(--dim); margin-bottom: 6px; }
  #plabel b { color: var(--amber); font-weight: 600; }
  .bar { height: 10px; background: rgba(255,255,255,.06); border: 1px solid var(--line-soft); overflow: hidden; }
  #pfill {
    height: 100%; width: 0%; background: linear-gradient(90deg, #b3160e, #ff542a, #ffb35c);
    box-shadow: 0 0 12px rgba(255, 84, 42, .6); transition: width .25s ease;
  }
  #pct { color: var(--amber); }

  /* drop zone */
  #dz {
    margin-top: 14px; border: 1px dashed rgba(255, 122, 61, .35); padding: 12px 14px;
    font-size: 11.5px; color: var(--dim); line-height: 1.55;
    transition: border-color .2s, background .2s;
  }
  #dz.hover { border-color: var(--amber); background: rgba(255, 179, 92, .07); color: var(--text); }
  #dz summary { cursor: pointer; color: var(--amber); font-size: 12px; }
  #dz summary:hover { color: var(--ember-hot); }
  #dz pre { margin: 8px 0 0; max-height: 130px; overflow: auto; font-size: 11px; color: var(--text); }

  /* console */
  #console {
    margin-top: 12px; max-height: 110px; overflow: auto; font-size: 10.5px; line-height: 1.5;
    color: #6f655c; border-top: 1px solid var(--line-soft); padding-top: 8px;
  }
  #console .err { color: #ff6b57; }
  #console .ok { color: #9fd28f; }

  .kbd { color: var(--amber); }
  .foot { display: flex; justify-content: space-between; align-items: center; margin-top: 16px; font-size: 10.5px; color: #5c534c; }
  .foot a { color: #8a7f76; text-decoration: none; border-bottom: 1px dotted #4a423c; }
  .foot a:hover { color: var(--amber); }
  .pill { border: 1px solid var(--line-soft); padding: 2px 8px; }

  /* toast */
  #toast {
    position: fixed; left: 50%; bottom: 34px; transform: translateX(-50%) translateY(20px);
    background: rgba(20,10,6,.92); border: 1px solid var(--line); color: var(--text);
    padding: 10px 18px; font-size: 12.5px; opacity: 0; pointer-events: none;
    transition: opacity .3s, transform .3s; z-index: 10; max-width: 80vw;
  }
  #toast.on { opacity: 1; transform: translateX(-50%) translateY(0); }

  /* mobile rotate hint (only while playing) */
  #rot {
    display: none; position: fixed; inset: 0; z-index: 20; place-items: center; text-align: center;
    background: rgba(0,0,0,.92); color: var(--text); font-size: 14px; line-height: 1.8; padding: 20px;
  }
  @media (max-width: 640px) and (orientation: portrait) {
    body.playing #rot { display: grid; }
  }

  @media (max-width: 640px) {
    .card { padding: 24px 20px 18px; margin: 2vh 0; }
    h1 { font-size: 21px; }
  }
  @media (prefers-reduced-motion: reduce) {
    * { animation: none !important; transition: none !important; }
  }
</style>
</head>
