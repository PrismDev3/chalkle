</div>

<div id="stack">
  <canvas class="emscripten" id="canvas" oncontextmenu="event.preventDefault()"></canvas>
  <div id="fx"></div>
</div>

<div id="shell">
  <div class="card" role="dialog" aria-label="NZ Portable launcher">
    <div class="brand">
      <img alt="icon" src="data:image/vnd.microsoft.icon;base64,">
      <h1>NAZI ZOMBIES: PORTABLE<span class="tag">SINGLE-FILE EDITION</span></h1>
    </div>
    <p class="blurb">
      The Call of Duty: Zombies de-make, running a <b>Quake-family engine compiled to WebAssembly</b> —
      engine, game data, and maps all embedded in this one HTML file. Works offline, anywhere, forever.
      Drag extra <b>.pk3</b> mods below before launching to load custom content.
    </p>

    <button class="btn primary" id="begin" type="button">&#9654;&nbsp; LAUNCH GAME</button>

    <div id="pwrap" hidden>
      <div id="plabel"><span id="pstage">Preparing</span><span><span id="pct">0%</span></span></div>
      <div class="bar"><div id="pfill"></div></div>
    </div>

    <details id="dz">
      <summary>&#128230; Mod files &amp; drop zone <span id="dzcount"></span></summary>
      <p style="margin:8px 0 4px">Drop <b>.pk3</b> / <b>.bsp</b> / <b>.cfg</b> / <b>.fmf</b> files here — or any gamedir folder — to make them available to the engine.</p>
      <pre id="dzlist" style="display:none"></pre>
    </details>

    <details style="margin-top:8px">
      <summary style="cursor:pointer;color:var(--amber);font-size:12px">&#127918; Controls</summary>
      <p style="margin:8px 0 0;font-size:11.5px;color:var(--dim);line-height:1.7">
        <span class="kbd">WASD</span> move &nbsp;·&nbsp; <span class="kbd">Mouse</span> aim / fire &nbsp;·&nbsp; <span class="kbd">Space</span> jump &nbsp;·&nbsp; <span class="kbd">R</span> reload<br>
        <span class="kbd">1–9</span> weapons &nbsp;·&nbsp; <span class="kbd">F</span> buy / use &nbsp;·&nbsp; <span class="kbd">Esc</span> menu &nbsp;·&nbsp; click canvas to capture mouse
      </p>
    </details>

    <details style="margin-top:8px">
      <summary style="cursor:pointer;color:var(--amber);font-size:12px">&#9881;&#65039; Options</summary>
      <div style="display:flex;gap:16px;margin-top:10px;font-size:12px;color:var(--dim);flex-wrap:wrap">
        <label><input type="checkbox" id="optCrt"> CRT filter</label>
        <label><input type="checkbox" id="optBg"> Background art</label>
        <label><input type="checkbox" id="optFs" checked> Fullscreen on launch</label>
      </div>
    </details>

    <div id="console" hidden></div>

    <div class="foot">
      <span class="pill" id="footNote">0 MB embedded</span>
      <span>
        <a href="https://github.com/NZPortables/nzportable" target="_blank" rel="noopener">project</a> ·
        <a href="https://nzp.gay/" target="_blank" rel="noopener">source site</a> ·
        rebuilt as one file
      </span>
    </div>
  </div>
</div>

<div id="toast" role="status"></div>
<div id="rot">&#128247; Rotate your device to landscape<br>for the full experience</div>

